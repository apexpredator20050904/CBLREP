APP_NAME=CBLREP
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
# Public origin of the API. Used for asset() URLs (listing photos) and links.
# Must match the origin clients call, or images resolve against the wrong host.
# Production: set this to your HTTPS origin, e.g. https://api.your-domain.com
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────────────
# Create the database first:
#   CREATE DATABASE community-based-portal
#     CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'cblrep'@'localhost' IDENTIFIED BY 'your_password';
#   GRANT ALL PRIVILEGES ON community-based-portal.* TO 'cblrep'@'localhost';
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=community-based-portal
DB_USERNAME=cblrep
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# API auth is stateless (Sanctum bearer tokens), so no session cookie is sent
# and CORS `supports_credentials` stays false — see config/cors.php.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password-reset codes are written to storage/logs/laravel.log instead of
# being e-mailed, which keeps the flow testable in local development.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"