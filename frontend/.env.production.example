# ─────────────────────────────────────────────────────────────────────────────
# CBLREP admin console · PRODUCTION environment (Debian + nginx, /admin on the
# API host). Copy to `.env.production` in the frontend build directory, or
# export the value at build time, then `npm run build`.
#
#   cp .env.production.example .env.production && npm run build
#
# VITE_* values are inlined into the bundle at BUILD time — changing one needs a
# rebuild. Only VITE_-prefixed vars reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Public origin of the Laravel API.
#
# The admin console is served from the SAME host as the API
# (https://api.cblrep.ph/login, /admin/*), so requests are same-origin and CORS
# does not apply. Leaving this EMPTY makes adminApi.js call relative `/api/*`,
# which nginx routes to PHP-FPM — the correct, simplest production value.
#
# Set it to an absolute origin only if you move the console to a different
# host (e.g. https://admin.cblrep.ph) — then also add that origin to
# backend/config/cors.php `allowed_origins`.
VITE_API_BASE_URL=

# Dev-server proxy target only. NOT used by `vite build`; do not set it here.
# VITE_API_TARGET=http://127.0.0.1:8000
