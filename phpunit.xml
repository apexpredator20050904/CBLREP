<?xml version="1.0" encoding="UTF-8"?>
<!--
    Local test configuration.

    WHY THIS DOES NOT USE SQLITE
    ============================

    Laravel's skeleton defaults to in-memory SQLite, but:

      1. pdo_sqlite is not installed on this machine (no pdo_sqlite.so on
         disk), so that connection cannot connect at all.
      2. Migration 2026_10_04_000002 uses MariaDB-specific DDL: a STORED
         generated column plus a plain unique index, because MariaDB has no
         functional-key index. SQLite cannot execute it.

    The suite therefore runs against the development MariaDB database.

    SAFETY: READ BEFORE EDITING
    ===========================

    These tests use DatabaseTransactions, NOT RefreshDatabase.

    Laravel's `migrate:fresh` (which RefreshDatabase triggers) calls
    MySqlBuilder::dropAllTables(), which lists every table in the schema with
    no table-prefix exemption. Pointed at the development database it would
    DROP the development rows as well. DatabaseTransactions wraps each test in
    a transaction and rolls it back, leaving the schema and all existing rows
    untouched.

    Switching these tests to RefreshDatabase will wipe the local database. Use a
    dedicated test schema first if you need RefreshDatabase semantics.

    The schema must be current before running the suite:
        php artisan migrate

    Tests skip (rather than fail) when the configured database is unreachable,
    so a typo in these credentials surfaces as a clear message rather than a
    connection stack trace.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnNotice="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="false"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="community-based-portal"/>
        <env name="DB_USERNAME" value="cblrep"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="FILESYSTEM_DISK" value="array"/>
    </php>
</phpunit>