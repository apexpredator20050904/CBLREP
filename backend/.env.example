APP_NAME=CBLREP
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
# Public origin of the API. Used for asset() URLs (listing photos) and links.
# Must match the origin clients call, or images resolve against the wrong host.
# Production: set this to your HTTPS origin, e.g. https://api.your-domain.com
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────────────
# Create the database first:
#   CREATE DATABASE community-based-portal
#     CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'cblrep'@'localhost' IDENTIFIED BY 'your_password';
#   GRANT ALL PRIVILEGES ON community-based-portal.* TO 'cblrep'@'localhost';
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=community-based-portal
DB_USERNAME=cblrep
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# API auth is stateless (Sanctum bearer tokens), so no session cookie is sent
# and CORS `supports_credentials` stays false — see config/cors.php.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password-reset codes are written to storage/logs/laravel.log instead of
# being e-mailed, which keeps the flow testable in local development.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Push notifications (Firebase Cloud Messaging) ───────────────────────────
# The mobile app registers an FCM token so the backend can push chat alerts
# even when the app is closed. Without these, push is silently disabled and the
# app still works via its in-app notification poll.
#
# FIREBASE_CREDENTIALS = absolute path to the service-account JSON downloaded
#   from Firebase console → Project settings → Service accounts → Generate new
#   private key. Keep the file OUT of git (see .gitignore).
# FIREBASE_PROJECT_ID = the Firebase project id (e.g. cblrep).
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# ── Mobile release channel (GET /api/app-version) ───────────────────────────
# The Flutter app checks this on launch to discover a newer APK. Set these when
# cutting a release to the value that matches the published build:
#   APP_VERSION_CODE          integer versionCode of the newest APK. MUST be
#                             greater than the previous release for the update
#                             prompt to fire.
#   APP_VERSION_NAME          human-readable version (e.g. 1.2.0).
#   APP_MIN_SUPPORTED_CODE    builds below this are force-updated (prompt cannot
#                             be dismissed). Keep at 1 unless an API change
#                             genuinely breaks old apps.
#   APP_APK_URL               absolute https URL of the APK (GitHub Release
#                             asset). Leave EMPTY to disable the prompt — the
#                             dev/ngrok backend should stay empty so testers are
#                             not nagged by an update they cannot install.
#   APP_APK_SHA256            optional sha256 of the APK.
#   APP_RELEASE_NOTES         short text shown in the update dialog.
APP_VERSION_CODE=1
APP_VERSION_NAME=1.0.0
APP_MIN_SUPPORTED_CODE=1
APP_APK_URL=
APP_APK_SHA256=
APP_RELEASE_NOTES=

VITE_APP_NAME="${APP_NAME}"