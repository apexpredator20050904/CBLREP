# =============================================================================
# CBLREP · Laravel API — PRODUCTION environment
# =============================================================================
# Copy to the server as backend/.env and fill in the two CHANGE_ME values:
#   sudo -u www-data cp backend/.env.production.example backend/.env
#   php artisan key:generate            # fills APP_KEY
#
# This is a template — never commit the real .env.
# =============================================================================

APP_NAME=CBLREP
APP_ENV=production
APP_KEY=
# MUST stay false in production: true leaks stack traces and .env values.
APP_DEBUG=false

# Public HTTPS origin. Used for asset()/URL generation (listing photos).
# Must be the exact origin clients call.
APP_URL=https://api.cblrep.ph

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Password hashing cost. 12 is a good production default on real hardware.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug in dev; use warning (or error) in production to keep logs useful/small.
LOG_LEVEL=warning

# ── Database (MariaDB/MySQL on the SAME host, bound to 127.0.0.1) ────────────
# The database name contains a hyphen, so it must be back-ticked in SQL:
#   CREATE DATABASE `community-based-portal`
#     CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'cblrep'@'localhost' IDENTIFIED BY 'CHANGE_ME';
#   GRANT ALL PRIVILEGES ON `community-based-portal`.* TO 'cblrep'@'localhost';
#   FLUSH PRIVILEGES;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=community-based-portal
DB_USERNAME=cblrep
DB_PASSWORD=CHANGE_ME

# Sanctum bearer tokens are stateless, so no session cookie is used by the API.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Force cookies to HTTPS-only once TLS is live.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password-reset codes are written to the log instead of e-mail. For a real
# deployment configure SMTP here (MAIL_MAILER=smtp, host/port/user/pass).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@cblrep.ph"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Push notifications (Firebase Cloud Messaging) ───────────────────────────
# Leave FIREBASE_CREDENTIALS empty to disable push: the API still works and the
# mobile app falls back to its in-app notification poll.
# The service-account JSON is a private key — keep it OUTSIDE the web root's
# public dir. Download it from: Firebase console → Project settings →
# Service accounts → Generate new private key.
FIREBASE_CREDENTIALS=/var/www/cblrep/backend/storage/app/firebase/service-account.json
FIREBASE_PROJECT_ID=cblrep

VITE_APP_NAME="${APP_NAME}"

# ── 2FA / encryption ─────────────────────────────────────────────────────────
# APP_KEY encrypts the TOTP secrets behind admin two-factor auth. If you MIGRATE
# an existing database (mysqldump restore) into this server, you MUST reuse that
# database's original APP_KEY or every enrolled admin's 2FA secret becomes
# unreadable and they are locked out. If you start from a fresh
# `php artisan migrate` + `admin:create`, generate a new key and ignore this.
