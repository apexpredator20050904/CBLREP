# Local environment — contains DB credentials. Never commit.
/.env
/.env.backup
/.env.production

# Composer / npm dependencies are reproducible from composer.lock.
/vendor/
/node_modules/

# Runtime caches and generated state.
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
# Test-uploaded attachments (Storage::fake disks live under testing/).
/storage/framework/testing/
/storage/logs/*
!/storage/logs/.gitignore
# Reports/state the API writes at runtime.
/storage/app/*.json
# Uploaded user content (listing photos, verification documents, chat
# attachments) is stored on the `public` disk and served via public/storage.
# It is user data, never source — keep it out of the repository.
/storage/app/public/*
!/storage/app/public/.gitignore
# The seeded community listings' photographs are part of the demo dataset, not
# user data: they are fetched from Wikimedia Commons by
# `tools/fetch_seed_photos.py` and committed here so a fresh clone (or a deploy
# to another server) has a board with real pictures on it. The credits for
# every one of them sit next to them in CREDITS.md. The directory itself has
# to be un-ignored first, or git never looks inside it.
/storage/app/public/seed-listings/
!/storage/app/public/seed-listings/*
/storage/app/private/*
!/storage/app/private/.gitignore
# Proof-of-residency documents now live on the `local` (private) disk, served
# only through the authenticated admin route. Private user data — never commit.
/storage/app/verification-documents/*
!/storage/app/verification-documents/.gitignore
# Firebase service-account key (server-side push credential) — never commit.
/storage/app/firebase/*
!/storage/app/firebase/.gitignore

# Compiled admin console / Laravel Vite output. Rebuild from `frontend/` with
# `npm run build`; never commit generated bundles.
/public/admin/
/public/build/
# `php artisan storage:link` recreates this on the server. The previously
# committed copy was a symlink to an absolute dev-machine path.
/public/storage

# Local SQLite database (the app runs on MySQL — see .env.example).
/database/*.sqlite

# Local tooling
/.phpunit.result.cache
/.php-cs-fixer.cache